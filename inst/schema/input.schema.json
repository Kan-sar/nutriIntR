{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutrientengine:input:1.0.0",
  "title": "Nutrient event scenario",
  "type": "object",
  "required": ["context", "events"],
  "properties": {
    "interpolate": {"type": "boolean", "default": false},
    "context": {
      "type": "object",
      "required": ["population", "meal_state"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "meal_state": {"type": "string", "minLength": 1}
      }
    },
    "events": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "nutrient", "form", "amount", "unit", "time_minutes", "meal_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "nutrient": {"type": "string", "minLength": 1},
          "form": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "unit": {"enum": ["g", "mg", "mcg", "ug"]},
          "time_minutes": {"type": "number", "minimum": 0},
          "meal_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$comment": "Runtime additionally enforces unique IDs, finite values and nonblank strings. Unknown nutrients/forms are accepted and reported as unsupported."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutrientengine:input:1.3.0",
  "title": "Nutrient event scenario",
  "type": "object",
  "required": ["context", "events"],
  "properties": {
    "interpolate": {"type": "boolean", "default": false},
    "context": {
      "type": "object",
      "required": ["population", "meal_state"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "meal_state": {"type": "string", "minLength": 1}
      }
    },
    "medications": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "medication", "route"],
        "anyOf": [{"required": ["time_minutes"]}, {"required": ["consumed_at"]}],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "medication": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "time_minutes": {"type": "number", "minimum": 0},
          "consumed_at": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
          }
        }
      }
    },
    "events": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "nutrient", "form", "amount", "unit", "meal_id"],
        "anyOf": [{"required": ["time_minutes"]}, {"required": ["consumed_at"]}],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "nutrient": {"type": "string", "minLength": 1},
          "form": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "minLength": 1},
          "time_minutes": {"type": "number", "minimum": 0},
          "consumed_at": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T)?[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
          },
          "meal_id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$comment": "Runtime additionally enforces unique IDs, finite values, nonblank strings, calendar validity, compatible USDA units, and one shared timestamp/offset mode for nutrient and medication events. Timestamps take precedence over offsets when both are supplied. USDA IDs can be entered as strings such as usda_1104 or 1104."
}

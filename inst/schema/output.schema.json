{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nutrientengine:output:1.1.0",
  "title": "Nutrient interaction evidence result",
  "type": "object",
  "required": ["schema_version", "engine_version", "mode", "context", "events", "targets", "interactions", "warnings", "provenance"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "engine_version": {"type": "string"},
    "mode": {"const": "evidence_explorer"},
    "context": {"type": "object"},
    "chronology": {
      "type": "object", "required": ["mode", "origin_local"],
      "properties": {
        "mode": {"enum": ["minute_offsets", "consumption_times"]},
        "origin_local": {"type": ["string", "null"]}
      }
    },
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["usda_nutrient_id", "nutrient_name", "canonical_unit", "amount_canonical", "amount_mg", "consumed_at", "consumed_at_local", "time_minutes"],
        "properties": {
          "usda_nutrient_id": {"type": ["integer", "null"]},
          "nutrient_name": {"type": "string"},
          "canonical_unit": {"type": "string"},
          "amount_canonical": {"type": "number", "minimum": 0},
          "amount_mg": {"type": ["number", "null"], "minimum": 0},
          "consumed_at": {"type": ["string", "null"]},
          "consumed_at_local": {"type": ["string", "null"]},
          "time_minutes": {"type": "number", "minimum": 0}
        }
      }
    },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "evidence_directions", "baseline_bioavailability", "adjusted_bioavailability", "combined_relative_effect"],
        "properties": {
          "event_id": {"type": "string"},
          "evidence_directions": {"type": "array", "items": {"type": "string"}},
          "baseline_bioavailability": {"type": "null"},
          "adjusted_bioavailability": {"type": "null"},
          "combined_relative_effect": {"type": "null"}
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "status", "direction", "source_minus_target_minutes", "study_reference", "citation"],
        "properties": {
          "source_id": {"type": "string"},
          "target_id": {"type": "string"},
          "status": {"enum": ["unsupported_pair", "unsupported_form", "timing_unresolved", "unsupported_context", "zero_dose", "qualitative_evidence", "within_meal_timing_unresolved"]},
          "direction": {"enum": ["enhances", "inhibits", "no_detected_effect", "unknown"]},
          "source_minus_target_minutes": {"type": "number"},
          "citation": {"type": ["object", "null"]},
          "study_reference": {
            "type": ["object", "null"],
            "properties": {
              "relative_absorption": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "method": {"enum": ["reported_study_anchor", "exploratory_log_dose_interpolation", "not_estimated"]},
              "lower": {"type": "null"},
              "upper": {"type": "null"}
            }
          }
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}
